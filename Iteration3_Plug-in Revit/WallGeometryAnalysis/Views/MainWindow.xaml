<Window x:Class="WallGeometryAnalysis.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WallGeometryAnalysis.Views"
        mc:Ignorable="d"
        xmlns:ViewModel ="clr-namespace:WallGeometryAnalysis.ViewModels"
        d:DataContext="{d:DesignInstance ViewModel:MainWindowViewModel}"
        Title="WallGeometryAnalysis" Height="500" Width="350"
        ResizeMode ="CanMinimize">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="16"
            FontWeight="Bold"
            Margin="10"
            HorizontalAlignment="Center"
            Text="Анализ геометрии стены"/>

        <Button
            Grid.Row="1"
            Margin="10 10 10 17" Padding="5"
            Width="100"
            FontWeight="SemiBold"
            HorizontalAlignment="Center"
            Content="Выбрать стену"
            Background="LightSteelBlue"
            BorderBrush="LightGray" BorderThickness="0.5" 
            Command="{Binding CalcWall}"/>

        <Border
            Grid.Row="2"
            Margin="10"
            CornerRadius="10"
            Background="AliceBlue"
            BorderThickness="0.5"
            BorderBrush="LightGray">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label
                    Grid.Row="0"
                    Margin="15,-11,0,-1"
                    Padding="2 1 2 0"
                    HorizontalAlignment="Left"
                    FontWeight="SemiBold"
                    Content="Информация о модели"
                    Background="White"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Padding="17 10 10 5"
                        HorizontalAlignment="Center"
                        Text="Имя стены:"/>

                    <TextBlock
                        Grid.Column="1"
                        Padding="10 10 10 5"
                        HorizontalAlignment="Left"
                        FontWeight="SemiBold"
                        Text="{Binding WallInfo.WallName}"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Padding="17 5 10 15"
                        HorizontalAlignment="Center"
                        Text="Тип:"/>

                    <TextBlock
                        Grid.Column="1"
                        Padding="10 5 10 15"
                        HorizontalAlignment="Left"
                        FontWeight="SemiBold"
                        Text="{Binding WallInfo.WallType}"/>
                </Grid>
            </Grid>
        </Border>

        <Border
            Grid.Row="3"
            Margin="10"
            CornerRadius="10"
            Background="AliceBlue"
            BorderThickness="0.5"
            BorderBrush="LightGray">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label
                    Grid.Row="0"
                    Margin="15,-11,0,-1"
                    Padding="2 1 2 0"
                    HorizontalAlignment="Left"
                    FontWeight="SemiBold"
                    Content="Геометрические параметры"
                    Background="White"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="0.5*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                         Grid.Column="0" Grid.Row="0"
                         Padding="17 10 10 5"
                         HorizontalAlignment="Left"
                         Text="Длина:"/>

                    <TextBlock
                         Grid.Column="1" Grid.Row="0"
                         Padding="10 10 10 5"
                         HorizontalAlignment="Left"
                         Text="{Binding WallInfo.Length}"/>

                    <TextBlock
                         Grid.Column="2" Grid.Row="0"
                         Padding="0 10 10 5"
                         HorizontalAlignment="Left"
                         Text="мм"/>

                    <TextBlock
                         Grid.Column="0" Grid.Row="1"
                         Padding="17 5 10 5"
                         HorizontalAlignment="Left"
                         Text="Высота:"/>

                    <TextBlock
                        Grid.Column="1" Grid.Row="1"
                        Padding="10 5 10 5"
                        HorizontalAlignment="Left"
                        Text="{Binding WallInfo.Height}"/>

                    <TextBlock
                         Grid.Column="2" Grid.Row="1"
                         Padding="0 5 10 5"
                         HorizontalAlignment="Left"
                         Text="мм"/>

                    <TextBlock
                         Grid.Column="0" Grid.Row="2"
                         Padding="17 5 10 5"
                         HorizontalAlignment="Left"
                         Text="Толщина:"/>

                    <TextBlock
                         Grid.Column="1" Grid.Row="2"
                         Padding="10 5 10 5"
                         HorizontalAlignment="Left"
                         Text="{Binding WallInfo.Thickness}"/>

                    <TextBlock
                         Grid.Column="2" Grid.Row="2"
                         Padding="0 5 10 5"
                         HorizontalAlignment="Left"
                         Text="мм"/>

                    <TextBlock
                         Grid.Column="0" Grid.Row="3"
                         Padding="17 5 10 5"
                         HorizontalAlignment="Left"
                         Text="Объём:"/>

                    <TextBlock
                         Grid.Column="1" Grid.Row="3"
                         Padding="10 5 10 5"
                         HorizontalAlignment="Left"
                         Text="{Binding WallInfo.Volume}"/>

                    <TextBlock
                         Grid.Column="2" Grid.Row="3"
                         Padding="0 5 10 5"
                         HorizontalAlignment="Left"
                         Text="м3"/>

                    <TextBlock
                         Grid.Column="0" Grid.Row="4"
                         Padding="17 5 10 15"
                         HorizontalAlignment="Left"
                         Text="Площадь:"/>

                    <TextBlock
                         Grid.Column="1" Grid.Row="4"
                         Padding="10 5 10 15"
                         HorizontalAlignment="Left"
                         Text="{Binding WallInfo.Area}"/>

                    <TextBlock
                         Grid.Column="2" Grid.Row="4"
                         Padding="0 5 10 15"
                         HorizontalAlignment="Left"
                         Text="м2"/>
                </Grid>
            </Grid>
        </Border>

        <Border
            Grid.Row="4"
            Margin="10"
            CornerRadius="10"  >
            <Border.Style>
                <Style TargetType ="Border">
                    <Setter Property="BorderThickness" Value="0.5"/>
                    <Setter Property="Background" Value="AliceBlue"/>
                    <Setter Property="BorderBrush" Value="LightGray"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WallInfo.IsCorrect}" Value="True">
                            <Setter Property="Background" Value="#DFF4E0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding WallInfo.IsCorrect}" Value="False">
                            <Setter Property="Background" Value="#F9DDDD"/>
                        </DataTrigger>
                    </Style.Triggers>

                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label
                    Grid.Row="0"
                    Margin="15,-11,0,-1"
                    Padding="2 1 2 0"
                    HorizontalAlignment="Left"
                    FontWeight="SemiBold"
                    Content="Контроль толщины"
                    Background="White"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.5*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Padding="17 10 10 10"
                        HorizontalAlignment="Right"
                        Text="Предел толщины:"/>

                    <TextBox
                        Grid.Column="1"
                        Padding="10 2 2 2"
                        Height="25" Width="120"         
                        HorizontalAlignment="Left"
                        Text="{Binding ThicknessLimit}"/>

                    <TextBlock
                        Grid.Column="2"
                        Padding="0 10 0 10"
                        HorizontalAlignment="Left"
                        Text="мм"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Padding="10 5 10 0"
                        HorizontalAlignment="Right"
                        Text="Статус:"/>

                    <TextBlock Grid.Column="1">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="10 5 10 15"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Text" Value="-"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WallInfo.IsCorrect}" Value="True">
                                        <Setter Property="Text" Value="Соответствует"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WallInfo.IsCorrect}" Value="False">
                                        <Setter Property="Text" Value="Превышает"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
